# SecureCorp Frontend — Environment Variables
# Copy this file to .env and fill in values for your setup.
# Never commit .env — it is git-ignored.

# --- Backend API ---
# Base URL for the Flask Portal API. No trailing slash.
VITE_API_BASE_URL=http://localhost:5000/api

# --- Mock Mode ---
# Set to "false" to talk to the real Flask backend instead of the shared mocks.
# Keep as "true" (or unset) during early development before Checkpoint 3.
VITE_USE_MOCK=false
